            <Repeat size={12} className="text-muted-foreground" aria-label="Recurring" />
          )}
        </p>
        <p className="text-muted-foreground truncate text-xs">
          {transaction.type === 'transfer' && toAccount
            ? `${account?.name ?? '?'} → ${toAccount.name}`
